# ── Frontend ──────────────────────────────────────────────────────────────────
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_WS_URL=ws://localhost:8000/ws

# ── Backend (copy to a separate backend .env or root .env) ────────────────────
DATABASE_URL=sqlite:///./logs_security.db
SECRET_KEY=change-me-to-a-32-char-secret-key-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=1440
FRONTEND_URL=http://localhost:5173
ADMIN_USERNAME=admin
ADMIN_PASSWORD=Admin@12345
ALERT_THRESHOLD=5
BRUTE_FORCE_WINDOW=300
MAX_UPLOAD_SIZE_MB=50

# ── Feature 1: Email alerts ───────────────────────────────────────────────────
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your@gmail.com
EMAIL_PASSWORD=your-app-password
EMAIL_FROM=your@gmail.com
EMAIL_TO=admin@yourcompany.com
EMAIL_USE_TLS=true

# ── Feature 5: Scheduled reports ──────────────────────────────────────────────
REPORT_SCHEDULE_ENABLED=false
REPORT_SCHEDULE_HOUR=7
REPORT_EMAIL_TO=
